# ─── apps/web (Vercel) ───────────────────────────────────────────────────
# Public: sent to the browser. Safe only because RLS gates every table.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_LIVEKIT_URL=wss://

# Server only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
INTERNAL_SERVICE_TOKEN=

# ─── apps/voice-agent (Fly secrets) ──────────────────────────────────────
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
DATABASE_URL=postgresql://
SUPABASE_URL=
LIVEKIT_URL=wss://

# Selects the AI adapter. Only "anthropic" is implemented.
AI_PROVIDER=anthropic

# ─── payments: razorpay (apps/web) ───────────────────────────────────────
# Test Mode keys only in development. KEY_ID is sent to the browser for
# Checkout.js; the other two are server-only and must never be exposed.
# WEBHOOK_SECRET is chosen by you when creating the webhook in the Razorpay
# dashboard, and is all the inbound webhook route needs — signature
# verification does not use the API keys.
RAZORPAY_KEY_ID=rzp_test_
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
