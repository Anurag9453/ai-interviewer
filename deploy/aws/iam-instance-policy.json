{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOnlyVoiceAgentParameters",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath"
      ],
      "Resource": "arn:aws:ssm:ap-southeast-1:506734151055:parameter/ai-interviewer/voice/*"
    },
    {
      "Sid": "WriteWorkerLogsOnly",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "logs:DescribeLogStreams"
      ],
      "Resource": "arn:aws:logs:ap-southeast-1:506734151055:log-group:/ai-interviewer/voice-agent:*"
    }
  ]
}
